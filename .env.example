# ─── Database (Supabase / Neon) ──────────────────────────────────────────────
# Leave UNSET to run in demo mode with the seeded in-memory store (no DB needed).
# Set it to enable the Postgres backend; then run `npm run db:migrate && npm run db:seed`.
DATABASE_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL — used to build deep links in Slack/email notifications.
APP_URL=http://localhost:3000

# ─── Auth: Google Workspace SSO (restricted to @blanche) ─────────────────────
# Leave GOOGLE_CLIENT_ID unset to run in demo mode (act-as user switcher).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=blanche.xyz
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# ─── Slack (primary notification channel) ────────────────────────────────────
# Slack app with chat:write + im:write scopes. Enable Interactivity and point
# the request URL at /api/slack/interactivity for the "I chased today" button.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── Email (Resend, secondary channel) ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Blanche Tracker <tracker@blanche.xyz>

# ─── Cron (Vercel Cron hits /api/cron/notifications hourly) ──────────────────
# If set, the cron endpoint requires `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
