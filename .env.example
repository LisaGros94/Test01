# ── AI Engine ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voice (ElevenLabs) ────────────────────────────────────────────────────────
# Get API key: elevenlabs.io → Profile → API Keys
# Voice ID: from elevenlabs.io/voice-library (default: Adam)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── Auth (NextAuth) ────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Database (Supabase / PlanetScale) ─────────────────────────────────────────
DATABASE_URL=postgresql://...

# ── Open Banking (Tink) ───────────────────────────────────────────────────────
# Get credentials: console.tink.com
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
